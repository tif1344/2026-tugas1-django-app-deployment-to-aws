# Level 2 — EC2 + S3 (S3 files + SQLite)
# After changing this file:
#   uv run python manage.py collectstatic --noinput
#   sudo systemctl restart pcm

DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10

USE_S3=true
AWS_STORAGE_BUCKET_NAME=pcm-GROUP-assets
AWS_S3_REGION_NAME=ap-southeast-3

# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
# The EC2 instance gets credentials from its IAM role automatically.

# DATABASE_URL is still not set -> SQLite
