# Level 3 — EC2 + S3 + RDS (S3 files + PostgreSQL)
# After changing this file:
#   uv run python manage.py migrate
#   uv run python manage.py loaddata data.json   (once, see the Level 3 guide)
#   sudo systemctl restart pcm

DEBUG=false
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
ALLOWED_HOSTS=203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10

USE_S3=true
AWS_STORAGE_BUCKET_NAME=pcm-GROUP-assets
AWS_S3_REGION_NAME=us-east-1

# postgres://USER:PASSWORD@RDS_ENDPOINT:5432/DB_NAME?sslmode=require
# Use a password with letters and digits only, or URL-encode special characters.
DATABASE_URL=postgres://pcm_admin:PASSWORD@pcm-GROUP-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/pcm?sslmode=require
