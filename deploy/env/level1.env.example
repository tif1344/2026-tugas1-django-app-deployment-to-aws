# Level 1 — EC2 only (local files + SQLite)
# On the server:  cp ../deploy/env/level1.env.example .env   (inside /srv/pcm-website/app)
# After changing this file:  sudo systemctl restart pcm

DEBUG=false

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

# Your Elastic IP (and domain, if you have one), comma-separated.
ALLOWED_HOSTS=203.0.113.10
CSRF_TRUSTED_ORIGINS=http://203.0.113.10

USE_S3=false
# DATABASE_URL is not set -> SQLite file /srv/pcm-website/app/db.sqlite3
